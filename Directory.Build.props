<Project>
  <PropertyGroup>
    <GameManagedDir Condition="'$(GameManagedDir)' == ''">$(HOME)/.local/share/Steam/steamapps/common/Lethal Company/Lethal Company_Data/Managed</GameManagedDir>
    <BepInExCoreDir Condition="'$(BepInExCoreDir)' == ''">$(HOME)/.config/r2modmanPlus-local/LethalCompany/profiles/Default/BepInEx/core</BepInExCoreDir>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <LangVersion>12.0</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="BepInEx;0Harmony">
      <HintPath>$(BepInExCoreDir)/%(Identity).dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp;UnityEngine;UnityEngine.CoreModule">
      <HintPath>$(GameManagedDir)/%(Identity).dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
